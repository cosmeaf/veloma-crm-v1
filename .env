########################
# Django / Core
########################
SECRET_KEY=change-me-in-dev
DEBUG=True

# Hosts que podem servir a app (CSV)
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,api.alvelos.com

# Em dev vamos liberar o CORS e credenciais
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True

# CSRF: Django exige ESQUEMA + DOMÍNIO; lista de origins confiáveis (CSV)
CSRF_TRUSTED_ORIGINS=https://api.alvelos.com,http://api.alvelos.com,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Se estiver atrás de proxy/ingress que termina HTTPS (Nginx/Traefik), mantenha True
USE_X_FORWARDED_PROTO=True


########################
# Banco de Dados (opcional em dev)
########################
# DATABASE_URL=sqlite:///db.sqlite3
# Exemplo Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/veloma


########################
# Redis / Celery
########################
REDIS_URL=redis://127.0.0.1:6379/0


########################
# E-mail (Zoho EU) — dev com envio real
########################
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.eu
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=suporte@velomacontabilidade.com
EMAIL_HOST_PASSWORD=COLOQUE_AQUI_SUA_SENHA_OU_APP_PASSWORD
DEFAULT_FROM_EMAIL=suporte@velomacontabilidade.com
EMAIL_TIMEOUT=30

# Se preferir console em dev, troque:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


########################
# URLs públicas (opcional, útil p/ construção de links em e-mails)
########################
PUBLIC_BASE_URL=https://api.alvelos.com
FRONTEND_BASE_URL=http://localhost:3000

# Caminho de reset/verify usados pelos helpers (opcional; ajuste se seu front usa outros paths)
# AUTH_RESET_PATH=/reset-password
# AUTH_VERIFY_PATH=/verify-email
